{
  "name": "JoinRequest",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "description": "ID of the workspace to join"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the requester"
    },
    "user_name": {
      "type": "string",
      "description": "Name of the requester"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Skills of the requester"
    },
    "message": {
      "type": "string",
      "description": "Optional message from the requester"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Request status"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Email of the admin who reviewed"
    }
  },
  "required": [
    "workspace_id",
    "user_email",
    "user_name",
    "status"
  ]
}