{
  "name": "LeaveRequest",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "description": "Workspace ID"
    },
    "user_email": {
      "type": "string",
      "description": "Employee email"
    },
    "user_name": {
      "type": "string",
      "description": "Employee name"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Leave start date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Leave end date"
    },
    "reason": {
      "type": "string",
      "description": "Reason for leave"
    },
    "leave_type": {
      "type": "string",
      "enum": [
        "sick",
        "personal",
        "vacation",
        "emergency",
        "other"
      ],
      "description": "Type of leave"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Leave request status"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Admin who reviewed"
    }
  },
  "required": [
    "workspace_id",
    "user_email",
    "start_date",
    "end_date",
    "reason",
    "leave_type",
    "status"
  ]
}