{
  "name": "VideoSubmission",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "description": "Workspace ID"
    },
    "title": {
      "type": "string",
      "description": "Video title"
    },
    "description": {
      "type": "string",
      "description": "Video description"
    },
    "submitted_by": {
      "type": "string",
      "description": "Employee email"
    },
    "submitted_by_name": {
      "type": "string",
      "description": "Employee name"
    },
    "video_url": {
      "type": "string",
      "description": "Uploaded video file URL"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Thumbnail image URL"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Review status"
    },
    "review_comment": {
      "type": "string",
      "description": "Admin review comment"
    },
    "youtube_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags for YouTube upload"
    },
    "youtube_category": {
      "type": "string",
      "description": "YouTube category"
    }
  },
  "required": [
    "workspace_id",
    "title",
    "submitted_by",
    "video_url",
    "status"
  ]
}