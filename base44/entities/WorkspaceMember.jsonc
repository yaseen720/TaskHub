{
  "name": "WorkspaceMember",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "description": "ID of the workspace"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the member"
    },
    "user_name": {
      "type": "string",
      "description": "Display name of the member"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "employee"
      ],
      "description": "Role in the workspace"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Skills of the member"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "suspended"
      ],
      "default": "active",
      "description": "Member status"
    },
    "avatar_url": {
      "type": "string",
      "description": "Avatar URL"
    }
  },
  "required": [
    "workspace_id",
    "user_email",
    "role"
  ]
}